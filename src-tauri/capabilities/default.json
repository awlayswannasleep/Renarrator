{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Renarrator windows (settings + custom tray menu)",
  "windows": ["main", "tray-menu"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "dialog:default"
  ]
